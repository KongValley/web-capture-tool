{
  "name": "web-capture-tool",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Electron 网页登录 + 抓取工具：请求/响应体、Cookie、Storage、HTML 导出；适配 Windows 7 SP1 32 位",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "selftest:sw": "electron . --selftest --software-rendering",
    "bench": "electron . --bench",
    "bench:sw": "electron . --bench --software-rendering",
    "shots": "electron . --shots",
    "icon": "node dev/make-icon.js",
    "pack:dir": "electron-packager . --platform=win32 --arch=ia32 --overwrite --prune --out=dist --ignore=\"^/(dist|tmp)\" --icon=build/icon.ico --extra-resource=LICENSE",
    "pack:zip": "powershell -NoProfile -Command \"Compress-Archive -Path 'dist/web-capture-tool-win32-ia32' -DestinationPath 'dist/web-capture-tool-win32-ia32.zip' -Force\"",
    "pack": "npm run pack:dir && npm run pack:zip"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "22.3.27"
  }
}
